<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
    package="io.github.reme2" >
    
	<!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SYSTEM_OVERLAY_WINDOW" />

    <!-- 后台、保活 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    
    <!-- 前台服务权限 (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- Android 14+ 需要声明具体的前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    
    <!-- 其他可能有助于保活的权限 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:name="io.github.zeroaicy.util.crash.CrashApplication"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:supportsRtl="true"
        android:persistent="true"
        android:process=":reme2Main"
        android:resizeableActivity="true">
        <!-- android:name="io.github.zeroaicy.util.crash.CrashApplication" 这一个是crash崩溃日志功能-->
        <!--安卓11开始必须添加 所有文件访问权限 android:requestLegacyExternalStorage="true"-->
        <!--使用 android:theme="@style/AppTheme.Translucent" 可隐藏默认Toolbar导航栏-->
		
        <!-- 前台服务 - 悬浮窗 -->
        <service
            android:name=".FloatWordService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false"
            android:process=":FloatWordService">
            <!-- Android 14+ 需要声明前台服务类型属性 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="悬浮窗显示单词" />
        </service>

        <!-- 开机自启 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.REBOOT" />
            </intent-filter>
        </receiver>

        <activity
            android:exported="true"
            android:name="io.github.reme2.MainActivity"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        
        <!-- 如果你啥都不懂 不要动下面 你可以删除 -->
        <!-- 下面崩溃日志功能界面如果你删除了 java文件夹的io 把这里和上面application的name也一并删除了不然会闪退 -->
        <activity
            android:name="io.github.zeroaicy.util.crash.CrashActivity"
            android:exported="false"
            android:process=":crash" />
            <!-- 分享崩溃截图必要 请勿删除 如果使用取消注释 -->
            <!-- 将app/src/main/java/io/github/zeroaicy/util/crash/CrashActivity.java文件的注释也一并删除-->
            <!--provider
				android:name="android.support.v4.content.FileProvider"
				android:authorities="${applicationId}.fileprovider"
				android:exported="false"
				android:grantUriPermissions="true">
				<meta-data
					android:name="android.support.FILE_PROVIDER_PATHS"
					android:resource="@xml/file_paths" />
			</provider-->
    </application>

</manifest>
