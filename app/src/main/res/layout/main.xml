<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="16dp">

    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="reme2"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <Button
            android:id="@+id/btn_optimize"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="申请权限"
            android:textSize="12sp"
            android:textColor="#333333"
            android:paddingHorizontal="12dp"
            android:background="@drawable/button_gray_background"
            android:elevation="2dp"
            android:stateListAnimator="@null" />
    </RelativeLayout>

    <!-- 主内容卡片 -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 文本输入区域 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="悬浮窗文本"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_config_text"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="输入要显示的文本..."
                android:gravity="top|start"
                android:padding="12dp"
                android:background="@drawable/edit_text_background"
                android:textSize="14sp"
                android:textColor="#333333"
                android:inputType="textMultiLine" />

            <!-- 应用按钮 -->
            <Button
                android:id="@+id/btn_save_config"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="应用"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/button_gray_background"
                android:elevation="2dp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 控制卡片 -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 缩放控制 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示设置"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_zoom_out"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="缩小 (-)"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:background="@drawable/button_gray_background"
                    android:elevation="2dp"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_toggle_visibility"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.5"
                    android:text="隐藏/显示"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:background="@drawable/button_gray_background"
                    android:elevation="2dp"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_zoom_in"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="放大 (+)"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:background="@drawable/button_gray_background"
                    android:elevation="2dp"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 隐藏时长设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="隐藏时长 (分钟)"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_auto_hide_duration"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="30"
                android:inputType="number"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/edit_text_background"
                android:textSize="14sp"
                android:textColor="#333333" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>